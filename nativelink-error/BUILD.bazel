load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
    "rust_test_suite",
)

rust_library(
    name = "nativelink-error",
    srcs = [
        "src/lib.rs",
    ],
    # Keep in sync with the version in Cargo.toml: rules_rust feeds this into
    # CARGO_PKG_VERSION, which VERSION_MESSAGE_SUFFIX embeds into
    # client-facing error messages (issue #1044). Without it bazel builds
    # would report the rules_rust placeholder 0.0.0.
    version = "1.6.1",
    visibility = ["//visibility:public"],
    deps = [
        "//nativelink-metric",
        "//nativelink-proto",
        "@crates//:base64",
        "@crates//:mongodb",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:redis",
        "@crates//:reqwest",
        "@crates//:rustls-pki-types",
        "@crates//:serde",
        "@crates//:serde_json5",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:walkdir",
        "@crates//:zip",
    ],
)

rust_test_suite(
    name = "integration",
    timeout = "short",
    srcs = [
        "tests/error_tests.rs",
        "tests/lib_tests.rs",
    ],
    deps = [
        "//nativelink-error",
        "//nativelink-metric",
        "//nativelink-proto",
        "@crates//:prost",
        "@crates//:redis",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:walkdir",
    ],
)

rust_test(
    name = "unit_test",
    timeout = "short",
    crate = ":nativelink-error",
    deps = [
        "//nativelink-metric",
        "//nativelink-proto",
        "@crates//:async-lock",
        "@crates//:hex",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:redis",
        "@crates//:serde",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_doc(
    name = "docs",
    crate = ":nativelink-error",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":nativelink-error",
)
